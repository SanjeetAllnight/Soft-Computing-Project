# ==============================================================================
# Large Datasets & Archives (> GitHub 100 MB Limit)
# ==============================================================================

# Raw Jigsaw Toxic Comment CSVs (~66 MB, ~58 MB)
train.csv
test.csv
train.csv.zip
test.csv.zip

# Sparse TF-IDF matrices (~67 MB, ~17 MB)
X_train.npz
X_val.npz

# MLRan full dataset (multi-GB parquet + huge JSON dictionaries)
Assignment/MLRan_full_dataset/
Assignment/MLRan_full_dataset.zip

# Demo bundle ZIPs (~84 MB each)
Soft_Computing_Project_Demo_Bundle.zip
Soft_Computing_Project_Demo_RF_Final_Bundle.zip

# Catch any other large archives
*.zip

