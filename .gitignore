scratch*/
tmp*/
demo_bundle_test*/

# ==============================================================================
# Explicit Keeps (override glob rules above)
# ==============================================================================

# Small numpy arrays (selected features, labels) — all < 128 KB
!selected_features_*.npy
!y_train.npy
!y_val.npy

# Small processed sample (~2.2 MB)
!processed_data/processed_sample.csv
